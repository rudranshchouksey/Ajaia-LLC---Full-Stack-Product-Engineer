# Copy to .env.local for local development.

# Local dev: a SQLite file (default if unset). The directory is created automatically.
DATABASE_URL=file:./data/app.db

# Production (Turso): use the libsql:// URL and an auth token, e.g.
# DATABASE_URL=libsql://collab-docs-<your-org>.turso.io
# DATABASE_AUTH_TOKEN=<output of `turso db tokens create collab-docs`>
DATABASE_AUTH_TOKEN=
